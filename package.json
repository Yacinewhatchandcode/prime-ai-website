{
  "name": "prime-ai.fr",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run julia:build && vite --host 0.0.0.0",
    "dev:https": "npm run julia:build && vite --config vite.https.config.js --host 0.0.0.0",
    "julia:build": "npm --prefix packages/julia-runtime run build",
    "test": "node --test packages/julia-runtime/test/*.test.js",
    "build": "npm run julia:build && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@solana/web3.js": "^1.98.4",
    "@tauri-apps/api": "^2.11.0",
    "buffer": "^6.0.3",
    "cli-progress": "^3.12.0",
    "lucide-react": "^1.16.0",
    "nodemailer": "^8.0.7",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.15.1",
    "resend": "^6.12.3",
    "swiper": "^12.1.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tauri-apps/cli": "^2.11.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "vite": "^8.0.12"
  }
